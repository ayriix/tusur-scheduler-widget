<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lesson_item_root"
    android:layout_width="match_parent"
    android:layout_height="68dp">

    <ImageView
        android:id="@+id/lesson_item_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/lesson_item_accent"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#8A4E38" />

        <TextView
            android:id="@+id/lesson_item_time"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="10:40\n12:15"
            android:textColor="#66675F"
            android:textSize="10sp"
            android:lineSpacingExtra="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lesson_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="История России"
                android:textColor="#242521"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lesson_item_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="гк 428"
                android:textColor="#66675F"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

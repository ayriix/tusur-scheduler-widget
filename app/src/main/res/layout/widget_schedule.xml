<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="576-1"
                android:textColor="#242521"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ВТ · 10 НОЯБРЯ"
                android:textColor="#66675F"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="СЕЙЧАС · 10:40–12:15"
            android:textColor="#8A4E38"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="5dp">

            <ListView
                android:id="@+id/widget_lessons"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:cacheColorHint="#00000000"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="5dp"
                android:padding="0dp"
                android:scrollbars="none"
                android:fastScrollEnabled="false" />

            <TextView
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="На этот день занятий нет"
                android:textColor="#66675F"
                android:textSize="13sp" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#25000000" />

        <LinearLayout
            android:id="@+id/widget_footer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="10.11 20:27"
                android:contentDescription="Время последнего обновления"
                android:textColor="#66675F"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_previous"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:contentDescription="Предыдущий день"
                android:text="‹"
                android:textColor="#242521"
                android:textSize="27sp" />

            <TextView
                android:id="@+id/widget_next"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:contentDescription="Следующий день"
                android:text="›"
                android:textColor="#242521"
                android:textSize="27sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
